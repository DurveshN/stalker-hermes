# ============================================================================
# Stalker Hermes — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# ============================================================================

# --- Orchestrator LLM (Anthropic Claude via Vercel AI SDK) ------------------
# Manager/synthesis: claude-sonnet-5 ; Specialists: claude-haiku-4-5
ANTHROPIC_API_KEY=

# --- Linkup (web search — POWER-UP) -----------------------------------------
# https://app.linkup.so  -> API keys
LINKUP_API_KEY=

# --- Convex (main reactive backend — POWER-UP) ------------------------------
# From `npx convex dev` / dashboard. URL like https://xxxx.convex.cloud
CONVEX_URL=
# Deploy key for CI / headless deploy (Convex dashboard -> Settings -> Deploy Keys)
CONVEX_DEPLOY_KEY=

# --- Azure Postgres (durable analytical warehouse) --------------------------
# Filled by infra/provision-postgres.sh
PGHOST=
PGPORT=5432
PGDATABASE=stalker
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# --- Telegram (Hermes gateway already configured on VM; orchestrator also
#     sends escalations + voice notes directly) -------------------------------
TELEGRAM_BOT_TOKEN=
# Chat/channel id to deliver escalations to (Hermes home channel)
TELEGRAM_CHAT_ID=

# --- ElevenLabs (voice intel briefs — POWER-UP) -----------------------------
ELEVENLABS_API_KEY=
# Voice id (default: Rachel). Pick any from your ElevenLabs voice library.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Dodo Payments (Pro-tier checkout — POWER-UP) ---------------------------
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_ID_PRO=

# --- Orchestrator runtime knobs ---------------------------------------------
# Default cadence handled by Hermes cron; this is a safety poll interval (ms)
RUNQUEUE_POLL_MS=4000
# Per-run hard budget guard (USD). Manager aborts if exceeded.
RUN_COST_CAP_USD=0.50
# Max specialists the manager may run in parallel
MAX_PARALLEL_SPECIALISTS=5
